# ---------------------------------------------------------------------------
# CodeShare Plus — environment template
#
# Copy to `.env.local` for local development:
#     cp .env.example .env.local
#
# Everything here is server-side configuration. Only variables prefixed with
# NEXT_PUBLIC_ are ever exposed to the browser. Never commit real secrets.
# ---------------------------------------------------------------------------

# --- Public -----------------------------------------------------------------
# Absolute origin of the deployment; used for share links, metadata and cookies.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Database (required) ----------------------------------------------------
# PostgreSQL connection string used for ALL data access.
# Supabase: Project Settings -> Database -> Connection string -> "Session pooler"
# (use the pooled string from serverless platforms; the direct string works too).
# The value below matches `npm run dev:db` (a local embedded PostgreSQL instance).
DATABASE_URL="postgresql://codeshare:codeshare@127.0.0.1:54329/codeshare_plus"

# --- Supabase Auth (optional) ----------------------------------------------
# Required only for accounts (guest mode works without any of these).
# Supabase: Project Settings -> API.
# Use either the legacy "anon" JWT key or the newer "Publishable key"
# (sb_publishable_...); both are designed to be public in browsers.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# --- File storage -----------------------------------------------------------
# Driver: "supabase" (private bucket, production) or "local" (filesystem, dev/tests).
# When unset: supabase is used if SUPABASE_SERVICE_ROLE_KEY is present, otherwise
# local (development/test only). Production requires an explicit value.
STORAGE_DRIVER="local"
# Supabase: Project Settings -> API -> service_role key, or the newer
# "Secret key" (sb_secret_...). SERVER-ONLY.
# This key bypasses Row Level Security; never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="share-files"
# Only used by the local driver (relative paths resolve from the project root).
LOCAL_STORAGE_DIR=".data/storage"

# --- Upload and collection limits (binary MB) -------------------------------
MAX_UPLOAD_MB="50"            # largest single file (direct-to-storage uploads)
MAX_PROXIED_UPLOAD_MB="4"     # largest file routed through the API (serverless body limit)
MAX_SHARE_TOTAL_MB="500"      # total bytes per collection
MAX_ITEMS_PER_SHARE="50"
MAX_FILES_PER_SHARE="25"
MAX_TEXT_ITEM_KB="200"        # per code/text item
MAX_ZIP_TOTAL_MB="200"        # ZIP export budget
MAX_TEXT_PREVIEW_KB="512"
MAX_CSV_PREVIEW_MB="2"
MAX_MARKDOWN_PREVIEW_KB="512"

# --- Abuse controls ---------------------------------------------------------
RATE_LIMIT_CREATE_PER_HOUR="10"          # guest share creations, per client
RATE_LIMIT_PASSWORD_PER_15MIN="10"       # password attempts, per client + share
RATE_LIMIT_UPLOAD_PER_HOUR="60"
RATE_LIMIT_READ_PER_MINUTE="300"
RATE_LIMIT_GUEST_BYTES_PER_DAY_MB="500"  # upload bytes per guest session per day

# --- Hashing ----------------------------------------------------------------
# Salt for privacy hashes (rate-limit keys, event fingerprints). Use a long
# random value in production: `openssl rand -hex 32`.
HASH_SALT="dev-only-change-me"
# bcrypt cost for share passwords (10-15). 12 is a good production default.
BCRYPT_COST="12"

# --- Maintenance ------------------------------------------------------------
# Shared secret for POST/GET /api/cron/maintenance (Vercel Cron sends this as a
# Bearer token). Generate with `openssl rand -hex 32`.
CRON_SECRET=""
